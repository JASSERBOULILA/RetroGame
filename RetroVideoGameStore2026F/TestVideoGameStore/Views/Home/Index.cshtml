@model IEnumerable<TestVideoGameStore.Models.Product>

@{
    ViewData["Title"] = "Home";
}

<h1 class="display-4">Retro Video Game Store</h1>

<h3>Our Products</h3>

<table class="table table-striped table-hover">
    <thead>
        <tr>
            <th>Name</th>
            <th>Price</th>
            <th>Category</th>
            <th>Photo</th>
            <th>Description</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var product in Model)
        {
            <tr>
                <td>@product.Name</td>
                <td>@product.Price.ToString("C")</td>
                <td>@product.Category?.Name</td>
                <td>
                    <img src="@product.Photo"
                         alt="@product.Name"
                         width="100" />
                </td>
                <td>@product.Description</td>
            </tr>
        }
    </tbody>
</table>